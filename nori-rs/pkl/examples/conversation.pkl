// Evaluation produces an ordered list of data; it does not run these effects.
commands = new Listing {
  new Dynamic { op = "prompt"; text = "Investigate the failure" }
  new Dynamic { op = "spawn"; actor = "reviewer"; agent = "elizacp" }
  new Dynamic { op = "select-context"; start = 1; end = 1 }
  new Dynamic { op = "fork"; actor = "self"; start = 1; end = 1 }
  new Dynamic { op = "send"; recipient = "reviewer"; message = "Review this context" }
}

// An explicit external process. Compilation only creates this command; the
// harness records the intent before execution and never executes it on replay.
unsafe {
  program = "printf"
  args = List("Explicit external diagnostic\n")
}
